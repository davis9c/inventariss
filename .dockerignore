# Version control
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Documentation
README.md
LICENSE
API_REFERENCE_COMPLETE.md
phpunit.dist.xml
preload.php

# Tests
tests/

# Environment (will be mounted or copied)
.env

# Writable (will be mounted as volume)
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*
!writable/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Dependencies: image menjalankan `composer install --no-dev` sendiri.
# Kalau vendor ikut ter-copy, folder vendor host menimpa hasil itu dan
# dependency development (phpunit, php-parse) ikut terbawa ke production.
vendor/

# Node (if any)
node_modules/

# Docker
Dockerfile
docker-compose.yml
.dockerignore
