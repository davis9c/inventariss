#=====================================================================
# Template konfigurasi environment — Sistem Inventaris
#=====================================================================
#
# Salin file ini menjadi .env lalu sesuaikan nilai bertanda [PER MESIN]:
#
#     cp .env.example .env
#
# .env tidak di-commit, jadi setiap mesin punya salinannya sendiri. File ini
# yang di-commit, sebagai acuan nilai apa saja yang dibutuhkan.
#
# Seluruh konfigurasi aplikasi berasal dari .env. docker-compose.yml tidak
# melakukan override apa pun selain CI_ENVIRONMENT, jadi tidak ada
# konfigurasi yang harus diubah di dua tempat.


#---------------------------------------------------------------------
# DOCKER
#---------------------------------------------------------------------
APP_PORT = 8082

#---------------------------------------------------------------------
# ENVIRONMENT
#---------------------------------------------------------------------
# Nilai di sini dipakai server pengembangan. Container-production
# menimpanya dengan production lewat docker-compose.yml.
CI_ENVIRONMENT = development

#---------------------------------------------------------------------
# APP  [PER MESIN]
#---------------------------------------------------------------------
# URL dasar aplikasi. Harus benar untuk mesin ini -- bukan sekadar piste.
# Nilai ini membangun action form login dan redirect, jadi kalau salah,
# login dikirim ke host yang salah dan tidak akan pernah berhasil.
app.baseURL = 'http://localhost:8092/'


#---------------------------------------------------------------------
# DATABASE  [PER MESIN]
#---------------------------------------------------------------------
# MySQL berada di luar Docker. Pastikan container bisa menjangkau host ini:
# dari dalam container, localhost berarti container itu sendiri.
database.default.hostname = 10.10.10.12
database.default.database = dev_inventaris
database.default.username = u24
database.default.password = ganti-ini
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306


#---------------------------------------------------------------------
# USERGATE API  [PER MESIN]
#---------------------------------------------------------------------
# Harus bisa dijangkau dari server pengembangan DAN dari container, karena
# keduanya memakai nilai ini. Jangan pakai localhost: dari dalam container
# itu berarti container itu sendiri, dan login gagal "Connection refused".
# Paki alamat IP, bukan localhost.
usergate.url = 'http://10.10.10.18:8091/api/v1'
usergate.api_key = ganti-ini
